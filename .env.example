# ==============================================
# Roneira AI HIFI — Environment Variables
# Copy this to .env.local and fill in your values
# ==============================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ML service. Server-side only -- deliberately NOT NEXT_PUBLIC_, so the internal
# hostname is never inlined into a client bundle.
ML_BACKEND_URL=http://localhost:8000

# Shared secret for calling the ML service. Must be IDENTICAL to ML_SERVICE_TOKEN
# in the ML service's own environment (see ml/.env.example) -- the FastAPI side
# rejects every data endpoint without it, and returns 503 if it is unset there.
# Generate one with:  openssl rand -hex 32
ML_SERVICE_TOKEN=

# Alpha Vantage — Stock data & fundamentals (free: 25 req/day)
ALPHA_VANTAGE_API_KEY=

# Finnhub — Real-time quotes & company data (free: 60 calls/min)
FINNHUB_API_KEY=

# NewsAPI — Market news (free: 100 req/day)
NEWS_API_KEY=

# Hugging Face — Sentiment analysis models
HUGGING_FACE_API_KEY=

# Twelve Data — Additional market data source
TWELVE_DATA_API_KEY=

# Upstash Redis — shared rate limiting across serverless instances
# (src/lib/server/rate-limit.ts). Response caching itself is in-process
# (src/lib/server/cache.ts), not Redis-backed. Without these two vars, rate
# limiting still works but is enforced per warm instance rather than globally.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Admin seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_USERNAME=

# ML artifact loading
ML_MODEL_DIR=./artifacts/generated
