# ML Service Environment Variables
# Canonical entrypoint: `uvicorn main:app` (FastAPI), matching Dockerfile/Procfile.
# Copy this file to `.env` and fill in real values for local development.

# Server
PORT=8000
ENVIRONMENT=development

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Optional API Keys (free tiers available)
HUGGING_FACE_API_KEY=
ALPHA_VANTAGE_API_KEY=demo

# Cache settings (seconds)
CACHE_TIMEOUT=300

# Optional shared infrastructure (only needed if running against docker-compose)
# DATABASE_URL=postgresql://roneira:password@localhost:5432/roneira_hifi
# REDIS_URL=redis://localhost:6379
