# Environment secrets - NEVER COMMIT
.env
.env.local
.env.production
.env*.local
!.env.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/

# ML Models
# TensorFlow-format artifacts stay untracked: they're large (10s-100s MB) and
# TF isn't even a declared dependency of ml/ (see ARCHITECTURE.md).
*.h5
*.keras
ml/models/trained/

# The gradient-boosted (xgboost) artifacts that actually back the LSTM/GAN
# slots ARE committed, on purpose. They're ~500KB each -- trivial for git, no
# LFS needed -- and committing them means Railway/Render's free tier boots
# with real trained models with zero training step at deploy time. That
# matters because free tiers there have no persistent disk and spin down
# after 15 min idle (Render), so training at boot would mean retraining on
# every cold start against a yfinance/Yahoo connection that's already proven
# to rate-limit (see ARCHITECTURE.md). Regenerate with `npm run train:ml` and
# commit the refreshed files when the data goes stale enough to matter.
ml/artifacts/generated/*
!ml/artifacts/generated/lstm_gbm.joblib
!ml/artifacts/generated/lstm_metadata.json
!ml/artifacts/generated/gan_gbm.joblib
!ml/artifacts/generated/gan_metadata.json

# Any other *.pkl in the tree (not the two files above) stays untracked --
# arbitrary pickles are a code-execution risk if ever sourced from outside
# this project (see ml/app/models/gradient_boost.py::load_artifact).
*.pkl

# Build caches
*.tsbuildinfo

# Playwright MCP browser artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# Stock screener output: a live-data snapshot at the moment it was generated,
# stale the instant markets move -- regenerate with `npm run export:stocks`,
# don't commit one run's numbers as if durable.
ml/exports/

# Misc
.DS_Store
*.log

# Legacy reference tree (see task.md): not built, tested, or deployed.
# Its lockfile is intentionally untracked — committing it published 18 CVEs
# (16 high) into code scanning for a tree that never ships, and remediating
# them needs breaking major upgrades. Refresh dependencies before reviving.
frontend/package-lock.json
