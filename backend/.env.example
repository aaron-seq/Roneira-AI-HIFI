# Backend Environment Variables
# Copy this file to `.env` for local development.

PORT=3001
NODE_ENV=development

# ML Service (FastAPI, uvicorn main:app) - defaults to the docker-compose port
ML_SERVICE_URL=http://localhost:8000

CORS_ORIGIN=http://localhost:3000

# Database - optional. When unset, portfolio persistence falls back to an
# in-memory store (data is lost on restart; a warning is logged).
# DATABASE_URL=postgresql://roneira:password@localhost:5432/roneira_hifi

# Redis - optional. When unset, caching falls back to an in-process memory cache.
# REDIS_URL=redis://localhost:6379

# Auth - required to issue/verify JWTs for /api/auth/* and protected routes.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# API Keys (Optional)
ALPHA_VANTAGE_API_KEY=demo

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
