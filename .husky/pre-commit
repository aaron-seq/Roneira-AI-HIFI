#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Checks the canonical surfaces only: src/ (Next.js) and ml/ (FastAPI).
# The previous version ran against backend/, frontend/, and ml-service/ -- all
# legacy trees that are not built, tested, or deployed -- so every commit passed
# a gate that validated nothing that ships. It also swallowed output with
# 2>/dev/null and cd'd into directories without checking they existed.
set -e

echo "🔍 Running pre-commit checks..."

echo "  ⌨️  type-check (src/)"
npm run type-check

echo "  🧹 lint (src/)"
npm run lint

echo "  🧪 tests (src/)"
npm run test:web

# Python suite takes ~14s, so only pay for it when ml/ actually changed.
if git diff --cached --name-only | grep -q '^ml/'; then
  echo "  🐍 pytest (ml/)"
  (cd ml && python -m pytest tests -q)
else
  echo "  🐍 pytest (ml/) — skipped, no ml/ changes staged"
fi

echo "✅ All pre-commit checks passed!"
