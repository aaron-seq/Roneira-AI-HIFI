#!/usr/bin/env sh
# Native Git hook installed by package.json's prepare script.
# Validate canonical web files and any staged ML/data changes.
set -e

echo "🔍 Running pre-commit checks..."

echo "  ⌨️  type-check (src/)"
npm run type-check

echo "  🧹 lint (src/)"
npm run lint

echo "  🧪 tests (src/)"
npm run test:web

# Run the ML suite only when that surface changed.
if git diff --cached --name-only | grep -q '^ml/'; then
  echo "  🐍 pytest (ml/)"
  (cd ml && python -m pytest tests -q)
else
  echo "  🐍 pytest (ml/) — skipped, no ml/ changes staged"
fi

if git diff --cached --name-only | grep -q '^data/'; then
  echo "  📊 data contracts and synthetic fixtures"
  python data/validate.py --metadata-only
  python data/validate.py
  python -m unittest discover -s data/tests -q
fi

echo "✅ All pre-commit checks passed!"
